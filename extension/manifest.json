{
  "manifest_version": 3,
  "name": "Cosmic JEV for Eventbrite",
  "version": "0.1.0",
  "description": "Glows event cards on Eventbrite green or red based on what the stars say about attending, per your birth chart.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.eventbrite.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.eventbrite.com/*",
    "https://cosmic-oracle-worker.cosmic-oracle.workers.dev/*"
  ],
  "permissions": ["storage"]
}
